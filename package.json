{
  "name": "bitewise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:fooddb",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "pretest": "npm run build:fooddb",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prevalidate:fooddb": "npm run build:fooddb",
    "validate:fooddb": "vitest run src/domain/fooddb/validate.test.ts",
    "build:fooddb": "tsx scripts/build-fooddb.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lighthouse": "lighthouse http://localhost:4173 --preset=desktop --chrome-flags=\"--headless=new\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@neondatabase/serverless": "^1.1.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "better-auth": "^1.7.1",
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
