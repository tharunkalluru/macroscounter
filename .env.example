# USDA FoodData Central API key (fallback product lookup for barcode scanning)
VITE_FDC_API_KEY=

# Vision-model API key for nutrition-label photo fallback (optional; manual entry used if unset)
LABEL_READER_API_KEY=
LABEL_READER_ENDPOINT=
VITE_LABEL_READER_ENABLED=false

# AI food logging (photo/voice/text -> estimated macros). Server-side only —
# deliberately has no VITE_ prefix, like LABEL_READER_API_KEY above, so
# it's never bundled into client code. Unset: the AI tab shows a "not
# configured" message and the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Cloud sync + Google sign-in (Phase 10) — see SETUP.md
DATABASE_URL=            # from Neon via Vercel Marketplace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=             # session signing
VITE_APP_URL=            # canonical URL for OAuth redirects

# Transactional email (password-reset links, sign-in codes) — from Resend,
# available via Vercel Marketplace. Unset: those flows silently no-op
# server-side (logged, not thrown) and Google sign-in keeps working.
RESEND_API_KEY=
# Optional: a verified sending domain's from-address, e.g. "Bitewise <hello@yourdomain.com>".
# Unset falls back to Resend's shared onboarding@resend.dev test address, which
# works immediately with no domain verification.
RESEND_FROM_EMAIL=

# Combined AI logging + coach requests allowed per account per UTC day
AI_DAILY_REQUEST_LIMIT=100
